# ~/.config/systemd/user/kacarong-convert.service 로 복사해서 쓴다.
# 파일 편집기의 문서 변환(LibreOffice). 사이트(kacarong-folio)는 유닉스 소켓을 못 만들게 가둬서 soffice를 못 띄우므로
# 변환만 이 서비스가 맡고, 사이트가 127.0.0.1:2994로 파일을 넘긴다(CONVERT_TOKEN이 맞아야 받음).
[Unit]
Description=kacarong.kr 문서 변환 서버
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/claude/kacarong-folio/web
# CONVERT_TOKEN, CONVERT_DIR=/home/claude/.local/share/kacarong-convert (사이트의 env와 같은 CONVERT_TOKEN)
EnvironmentFile=/home/claude/.config/kacarong-folio/convert.env
# 사이트처럼 Landlock으로 가둔다. 읽기: 시스템 파일, bun, 코드. 쓰기: 변환 작업 폴더뿐.
# soffice는 /tmp에 유닉스 소켓(OSL_PIPE_…)을 만들어야 돌아서 /tmp에는 소켓 만들기·지우기만, 주소 계열에는 AF_UNIX를 허용한다.
# 변환하는 문서는 로그인한 주인이 올린 것뿐이다. 경로를 바꾸면 아래 규칙도 같이 바꿀 것.
Environment=BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
ExecStart=/usr/bin/setpriv --landlock-access fs \
  --landlock-rule path-beneath:read-file,read-dir,execute:/usr \
  --landlock-rule path-beneath:read-file,read-dir:/etc \
  --landlock-rule path-beneath:read-file,read-dir:/proc \
  --landlock-rule path-beneath:read-file,read-dir:/sys \
  --landlock-rule path-beneath:read-file,write-file:/dev \
  --landlock-rule path-beneath:make-sock,remove-file:/tmp \
  --landlock-rule path-beneath:read-file,execute:/home/claude/.bun/bin \
  --landlock-rule path-beneath:read-file,read-dir:/home/claude/kacarong-folio \
  --landlock-rule path-beneath:read-file,read-dir,write-file,truncate,make-reg,make-dir,remove-file,remove-dir:/home/claude/.local/share/kacarong-convert \
  /home/claude/.bun/bin/bun src/convert-main.ts
Restart=always
RestartSec=5
MemoryMax=1G

[Install]
WantedBy=default.target
