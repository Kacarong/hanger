# /home/claude/.config/kacarong-folio/env (mode 600)
BASE_URL=https://kacarong.kr
# 구글 3개 값이 모두 있어야 구글 로그인·드라이브가 켜진다. 없으면 비밀번호 로그인만.
ADMIN_EMAIL=you@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATA_DIR=/home/claude/.local/share/kacarong-folio
PORT=2992
# 문서 변환 서버(deploy/kacarong-convert.service)와 같은 값. 없으면 문서 변환은 꺼짐.
CONVERT_TOKEN=
